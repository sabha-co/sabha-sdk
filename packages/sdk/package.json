{
  "name": "@sabha-co/sdk",
  "version": "0.1.0",
  "description": "Build apps on Sabha's apps API: one set of handlers over webhooks or the socket, with a Cloudflare host.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cloudflare.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p test/cloudflare/tsconfig.json",
    "test": "vitest run && vitest run -c vitest.cloudflare.config.ts",
    "gen:types": "node scripts/gen-types.ts",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.159.0",
    "ws": "^8.23.0"
  }
}
