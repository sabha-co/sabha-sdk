{
  "name": "app-kit-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "SABHA_SOCKET", "class_name": "SocketHost" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SocketHost"] }],
  "vars": {
    "SABHA_BASE_URL": "https://sabha.test",
    "SABHA_API_KEY": "sabha_app_cloudflare_key",
    "SABHA_SIGNING_SECRET": "whsec_cloudflare_secret",
    "TRANSPORT": "socket"
  }
}
